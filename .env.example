# ===========================================
# Heavy Lift WMS - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit real secrets to Git
# ===========================================

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# --- Auth (NextAuth.js v4) ---
# Required: random string for signing JWTs (min 32 chars)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of your deployment (used for cookies)
# On Vercel: https://your-domain.vercel.app
NEXTAUTH_URL=
