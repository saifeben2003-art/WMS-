# ═══════════════════════════════════════════
# CL WMS - Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
#

# ─── Database (PostgreSQL) ───────────────────
# Example (Vercel Postgres):
#   postgresql://user:password@host:5432/database?sslmode=require
# Example (Neon):
#   postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require
# Example (Supabase):
#   postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ─── Auth ───────────────────────────────────
# A random string for signing tokens (min 32 chars).
# Generate: openssl rand -base64 32
TOKEN_SECRET=

# ─── App ────────────────────────────────────
# Base URL of your deployment (used by auth cookies).
# On Vercel: https://your-domain.vercel.app
NEXTAUTH_URL=
